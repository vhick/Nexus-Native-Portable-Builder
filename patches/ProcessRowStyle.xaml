                     <ListView.ItemContainerStyle>
                         <!-- Processes only: the Windows ListViewItem template paints a
                              pale hover layer over the dark application palette.
                              Keep the real GridViewRowPresenter so columns, selection,
                              virtualisation, command handling and right-click remain intact. -->
                         <Style TargetType="{x:Type ListViewItem}"
                                BasedOn="{StaticResource {x:Type ListViewItem}}">
                             <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                             <Setter Property="Background" Value="Transparent"/>
                             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                             <Setter Property="Template">
                                 <Setter.Value>
                                     <ControlTemplate TargetType="{x:Type ListViewItem}">
                                         <Border x:Name="ProcessRowSurface"
                                                 Background="{TemplateBinding Background}"
                                                 BorderBrush="Transparent"
                                                 BorderThickness="1,0,1,0"
                                                 SnapsToDevicePixels="True">
                                             <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                 Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                         </Border>
                                         <ControlTemplate.Triggers>
                                             <!-- Normal hover: dark blue-gray, not system white -->
                                             <Trigger Property="IsMouseOver" Value="True">
                                                 <Setter TargetName="ProcessRowSurface" Property="Background" Value="#FF2C374B"/>
                                             </Trigger>
                                             <!-- Selected row remains distinguishable from hover -->
                                             <Trigger Property="IsSelected" Value="True">
                                                 <Setter TargetName="ProcessRowSurface" Property="Background" Value="#FF354664"/>
                                                 <Setter TargetName="ProcessRowSurface" Property="BorderBrush" Value="#FF617CB3"/>
                                             </Trigger>
                                             <MultiTrigger>
                                                 <MultiTrigger.Conditions>
                                                     <Condition Property="IsSelected" Value="True"/>
                                                     <Condition Property="IsMouseOver" Value="True"/>
                                                 </MultiTrigger.Conditions>
                                                 <Setter TargetName="ProcessRowSurface" Property="Background" Value="#FF405878"/>
                                             </MultiTrigger>
                                             <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                 <Setter TargetName="ProcessRowSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                             </Trigger>
                                             <Trigger Property="IsEnabled" Value="False">
                                                 <Setter Property="Opacity" Value="0.5"/>
                                             </Trigger>
                                         </ControlTemplate.Triggers>
                                     </ControlTemplate>
                                 </Setter.Value>
                             </Setter>
                         </Style>
                     </ListView.ItemContainerStyle>
